# Telegram API 凭据（必填 — 从 https://my.telegram.org/apps 获取）
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# --- 传入事件流（可选，Claude Code 回调模式；见 README） ---
# TELEGRAM_EVENT_FEED=1
# TELEGRAM_EVENT_FEED_FILE=/path/to/incoming_feed.jsonl

# --- 单账号（向后兼容） ---
# 长期运行的服务器推荐这种方式：Telegram 更新状态会持久化在本地。
TELEGRAM_SESSION_NAME=telegram_session
# 便于移植/迁移的来源：不会持久化 Telegram 更新状态。
# 若两个变量都设置，TELEGRAM_SESSION_STRING 优先，因此在执行完
# `uv run telegram-mcp-migrate-session` 后要删掉它或注释掉。
# TELEGRAM_SESSION_STRING=1231231232erfdfdffd

# --- 多账号 ---
# 给会话变量加 _<LABEL> 后缀，标签即成为账号标识。
# 所有账号共用 API_ID 与 API_HASH。
# TELEGRAM_SESSION_STRING_WORK=<工作账号的会话字符串>
# TELEGRAM_SESSION_STRING_PERSONAL=<个人账号的会话字符串>

# --- 会话池（同一账号，并发客户端） ---
# 让多个 MCP 客户端（例如桌面应用 AND 终端 CLI）同时使用一个 Telegram
# 账号，而不会触发 AuthKeyDuplicatedError。Telegram 禁止同一个会话
# （auth key）同时从两个 IP 使用；在 VPN/双栈主机上两个本地客户端会碰撞。
# 列出多个可互换的会话字符串（空格、逗号或分号分隔），每个进程通过
# 建议性文件锁认领一个空闲的。用 `uv run session_string_generator.py`
# 生成额外会话。对默认账号而言，它优先于 TELEGRAM_SESSION_STRING。
# TELEGRAM_SESSION_STRINGS=<会话 A> <会话 B> <会话 C>

# --- 会话锁（可选） ---
# 连接之前，每个服务进程会获取按会话划分的锁，这样第二个实例（例如连接器
# 重启）绝不会在第一个实例仍存活时连接同一个会话。
# exclusive（默认）：若等待 TELEGRAM_LOCK_GRACE_SECONDS（默认 20 秒）后
# 仍有实例持有该会话，则拒绝启动。
# shared：允许多个实例在本机共用一个会话 —— 仅当它们都从同一 IP 访问
# Telegram 时才安全；不确定的话请改用上面的会话池。
# TELEGRAM_SESSION_LOCK=exclusive
# TELEGRAM_LOCK_GRACE_SECONDS=20

# --- 设备标识（可选） ---
# 控制本客户端在 Telegram > 设置 > 设备 中如何显示。未设置时，
# Telethon 会回退到主机平台（例如 "arm64"）。设置这些值可以让会话在
# 重连后保持稳定、可识别的名称。生成会话字符串和服务器连接时都会生效。
# TELEGRAM_DEVICE_MODEL=Telegram MCP
# TELEGRAM_SYSTEM_VERSION=1.0
# TELEGRAM_APP_VERSION=1.0
# TELEGRAM_LANG_CODE=en
# TELEGRAM_SYSTEM_LANG_CODE=en

# --- 预期账号校验（可选） ---
# 若会话属于其他账号则拒绝启动。_<LABEL> 可覆盖。
# TELEGRAM_EXPECTED_USERNAME=my_username
# TELEGRAM_EXPECTED_USERNAME_WORK=my_work_username

# --- 全局聊天黑名单（可选） ---
# 对每个账号都生效。ID 使用工具返回的带标记形式。
# TELEGRAM_BLOCKED_CHAT_IDS=-100123456789,-4567,12345678,@unwanted_bot

# --- MCP 工具暴露（可选） ---
# 默认全部暴露。设为 read-only 时，只暴露在 MCP 中标注
# readOnlyHint=True 的工具。这不会降低服务器进程内 Telegram 会话的权限。
# TELEGRAM_EXPOSED_TOOLS=read-only
#
# 在 read-only 后追加 '+name,name'，可额外暴露指定的写工具；
# 其余写工具仍不注册。未知名称会导致启动失败。
# TELEGRAM_EXPOSED_TOOLS=read-only+send_message,reply_to_message
#
# 在任一基座之后（位于 '+' 列表之后）追加 '-name,name'，可隐藏指定工具。
# 未知名称，或基座已经隐藏的名称，都会导致启动失败。
# TELEGRAM_EXPOSED_TOOLS=all-delete_chat_history,delete_messages_bulk
# TELEGRAM_EXPOSED_TOOLS=read-only+send_message-get_participants

# --- 按工具的文件扩展名白名单（可选） ---
# 已有硬编码白名单把 send_voice/send_sticker/set_profile_photo/
# edit_chat_photo 限制在各自预期的扩展名内；send_file 与 upload_file
# 默认接受任意扩展名。用本项可在不改源码的情况下增加、收紧或替换
# 按工具的白名单。格式与 TELEGRAM_EXPOSED_TOOLS 一致：
# 'tool:.ext,.ext' 形式的条目，用 ';' 分隔。若某个工具已有硬编码默认值，
# 命名该工具会整体替换它的集合；未命名的工具保留默认值。扩展名不区分
# 大小写，前导点可省略。未知工具名、格式错误的扩展名、或同一工具重复
# 命名，都会导致启动失败。这是防误操作的多层防护，不是安全边界：
# 只检查最终的后缀名。
# TELEGRAM_FILE_EXTENSIONS=send_file:.pdf,.png,.jpg;upload_file:.pdf,.png

# --- 文件路径工具 / 允许的根目录（可选） ---
# 当 MCP 客户端实现了 Roots 但声明为空列表 —— 或 list_roots 意外失败且
# 无法恢复任何客户端路径 —— 时，文件路径工具（download_media、send_file
# 等）会被禁用（全部拒绝），即使配置了服务端 CLI 根目录。设为 1/true
# 可在这些情况下回退到服务端 CLI 根目录。默认全部拒绝。
# TELEGRAM_ALLOW_SERVER_ROOTS_FALLBACK=1
# 直接按原样使用服务端根目录，且从不发送 roots/list（适用于从不响应该
# 请求的客户端）。没有服务端根目录时无效。默认关闭。
# TELEGRAM_SERVER_ROOTS_ONLY=1

# --- HTTP/SSE 传输安全（可选） ---
# 仅当 MCP_TRANSPORT=http 或 sse 时相关。Host/Origin 校验始终开启：
# 默认只接受 127.0.0.1/localhost/[::1] 的 Host 头与浏览器 Origin。
# 如果服务器可通过域名访问（例如位于反向代理之后），请设置
# MCP_ALLOWED_HOSTS（浏览器客户端还需设置 MCP_ALLOWED_ORIGINS）；
# 两者各自替换本地默认值。逗号分隔；":*" 后缀表示任意端口。
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://mcp.example.com

# --- HTTP 鉴权（可选） ---
# 仅对 Streamable HTTP 传输（MCP_TRANSPORT=http）生效；stdio 模式忽略。
# 不设置任何一项时保持无鉴权，与旧版本行为一致。
# HTTP Basic：账号与密码必须同时设置，只设一半会导致启动失败。
# MCP_AUTH_USER=mcp
# MCP_AUTH_PASSWORD=<密码>
# Bearer Token：客户端发送 Authorization: Bearer <token>。
# MCP_AUTH_TOKEN=<长随机字符串>
# 两种可同时设置，任一通过即可。CORS 预检与签名的媒体/上传链接无需凭据。
# 通过 HTTPS 反向代理暴露到公网时务必启用，否则凭据与内容都是明文。

# --- 代理（可选） ---
# 让 Telegram 流量走代理。设置 TELEGRAM_PROXY_TYPE 即启用。
# 支持的类型：socks5、socks4、http、mtproxy。
# SOCKS/HTTP 代理需要 'python-socks' 包（通过
# `uv sync --extra proxy` 或 `pip install python-socks` 安装）。
# 按账号覆盖时使用与会话变量相同的 _<LABEL> 后缀。
# TELEGRAM_PROXY_TYPE=socks5
# TELEGRAM_PROXY_HOST=127.0.0.1
# TELEGRAM_PROXY_PORT=1080
# TELEGRAM_PROXY_USERNAME=<可选>
# TELEGRAM_PROXY_PASSWORD=<可选>
# TELEGRAM_PROXY_RDNS=true
# 使用 MTProxy 时，设置 TELEGRAM_PROXY_TYPE=mtproxy 并提供 secret：
# TELEGRAM_PROXY_SECRET=<十六进制 secret>
# 按账号覆盖示例：
# TELEGRAM_PROXY_TYPE_WORK=http
# TELEGRAM_PROXY_HOST_WORK=proxy.work.example
# TELEGRAM_PROXY_PORT_WORK=3128

# --- 记住的联系人（可选） ---
# TELEGRAM_ALIASES_FILE=/path/to/aliases.json
# TELEGRAM_CONTACT_FUZZY=0   # 仅精确匹配别名

# --- 手机号查询（可选） ---
# resolve_phone 的本地配额上限；不设置则都不启用。窗口为滚动的 24 小时。
# 没有状态文件时，重启后计数会重置。
# TELEGRAM_RESOLVE_PHONE_MAX_PER_DAY=12
# TELEGRAM_RESOLVE_PHONE_MIN_INTERVAL_SECONDS=5
# TELEGRAM_RESOLVE_PHONE_STATE_FILE=/path/to/resolve-phone.json

# --- 语音/视频留言转写（可选） ---
# off：禁用 transcribe_voice 工具，列表永远不显示转写。
# on-demand（默认）：transcribe_voice 可用；get_history/get_messages/
#   list_messages 会填充已经缓存的转写，但在列表操作中绝不花费 API
#   调用去抓取新的转写。
# auto：在列表操作中也会预取缺失的转写，每次调用受
#   TELEGRAM_TRANSCRIBE_MAX_VOICES / _MAX_SECONDS 限制。
# TELEGRAM_TRANSCRIBE=on-demand
#
# transcribe_voice 与 auto 模式预取默认使用哪个引擎
# （每次调用传入的 engine= 参数始终覆盖此设置）：
# - groq（默认）：Groq 托管的 whisper-large-v3-turbo。需要 GROQ_API_KEY。
#   会下载语音留言并发送到 Groq —— 数据离开服务器，不免费，但不像
#   Telegram 原生转写那样丢掉录音的最后几个词（2026-08-20 验证，见 docs）。
# - telegram：Telegram Premium 原生转写。免费，音频从不离开 Telegram，
#   但实测大约 2/3 的录音会丢掉最后一段语音。需要账号开通
#   Telegram Premium。适用于绝不应发送给第三方的聊天。
# - openai：任意兼容 OpenAI 的 /audio/transcriptions 端点（OpenAI、
#   自建的 Parakeet 或 speaches 服务器、LocalAI 等），可选 API key。
# - whisper：进程内的本地 faster-whisper 模型。音频从不离开机器。
#   需要：pip install 'telegram-mcp[whisper]'。
# TELEGRAM_TRANSCRIBE_ENGINE=groq
# GROQ_API_KEY=<Groq API key，只要用到 engine=groq 就必填>
#
# 给 groq/openai/whisper 的语言提示（ISO-639-1）。不设置 = 自动检测，
# 但在 Parakeet 服务器上，不发送语言时它会假定为英语。
# TELEGRAM_TRANSCRIBE_LANGUAGE=nl
# HTTP 引擎（groq/openai）的超时秒数。
# TELEGRAM_TRANSCRIBE_TIMEOUT=120
#
# engine=openai（base URL，类似 OpenAI SDK 的 base_url；也可以直接给
# 完整的 .../audio/transcriptions URL）。Parakeet（achetronic/parakeet）：
# http://localhost:5092/v1
# TELEGRAM_TRANSCRIBE_OPENAI_URL=https://api.openai.com/v1
# TELEGRAM_TRANSCRIBE_OPENAI_API_KEY=<API key，无密钥的本地服务器可留空>
# TELEGRAM_TRANSCRIBE_OPENAI_MODEL=whisper-1
# TELEGRAM_TRANSCRIBE_OPENAI_MAX_MB=25
#
# engine=whisper（faster-whisper 模型名或本地路径；每个进程只加载一次）
# TELEGRAM_TRANSCRIBE_WHISPER_MODEL=small
# TELEGRAM_TRANSCRIBE_WHISPER_DEVICE=auto          # auto / cpu / cuda
# TELEGRAM_TRANSCRIBE_WHISPER_COMPUTE_TYPE=default # CPU 上如 int8，GPU 上如 float16
# TELEGRAM_TRANSCRIBE_WHISPER_MODEL_DIR=<下载模型的存放位置>
#
# TELEGRAM_TRANSCRIBE=auto 预取的每次调用预算（其他情况忽略；
# transcribe_voice 本身是显式调用，从不做预算限制）。
# TELEGRAM_TRANSCRIBE_MAX_VOICES=5
# TELEGRAM_TRANSCRIBE_MAX_SECONDS=300
#
# SQLite 转写缓存的位置。这是磁盘上明文的私聊文本 —— 请放在挂载卷上
# （见 docker-compose.yml），并放在独立目录中，不要与其他任何备份共享。
# 文件权限会被设为 600，目录为 700。
# TELEGRAM_TRANSCRIPT_CACHE_DIR=data/transcripts
